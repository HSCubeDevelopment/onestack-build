// OneStack core data model — industry-neutral (no vertical nouns).
// Vehicle/Job etc. live in the automotive PACK, never here. See docs/architecture.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // owner/direct (Supabase `postgres`) — migrations + provisioning
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  STAFF

  @@map("onestack_role")
}

/// A customer of OneStack (one shop / clinic / firm). Owns everything. Not tenant-scoped (it IS the scope).
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships      Membership[]
  contacts         Contact[]
  featureFlags     FeatureFlag[]
  workItems        WorkItem[]
  workItemCounter  WorkItemCounter?
  subjects         Subject[]
  workItemSubjects WorkItemSubject[]
  outboxEvents     OutboxEvent[]
  inboxConsumed    InboxConsumed[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  lineItems         LineItem[]
  documents         Document[]
  quotes            Quote[]
  referenceCounters ReferenceCounter[]
  invoices          Invoice[]
  invoicePortions   InvoicePortion[]
  payments          Payment[]
  workItemNotes       WorkItemNote[]
  workItemAttachments WorkItemAttachment[]
  resources           Resource[]
  bookings            Booking[]
  leadForms           LeadForm[]
  leads               Lead[]
  customFieldDefs     CustomField[]
  priceBookItems      PriceBookItem[]
  damageScopes        DamageScope[]
  scopeParts          ScopePart[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderLines  PurchaseOrderLine[]
  materialRequests    MaterialRequest[]
  materialRequestLines MaterialRequestLine[]
  supplierInvoices    SupplierInvoice[]
  supplierInvoiceLines SupplierInvoiceLine[]
  tags                Tag[]
  contactTags         ContactTag[]
  intakeForms         IntakeForm[]
  intakeSubmissions   IntakeSubmission[]
  bookingPage         BookingPage?
  dispatches          Dispatch[]
  campaigns           Campaign[]
  reviews             Review[]
  assistantMessages   AssistantMessage[]
  documentSignatures  DocumentSignature[]
  portalAccess        PortalAccess[]
  brand               Brand?
  waitlist            WaitlistEntry[]
  shifts              Shift[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]

  @@map("onestack_tenant")
}

/// An invoice on a job (card #40), optionally from an accepted quote. Line items are the shared
/// onestack_line_item; totals derived. Paid manually (records who + when). Tenant-scoped.
model Invoice {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  workItemId     String           @db.Uuid // the job
  quoteId        String?          @db.Uuid // source quote (optional)
  payerContactId String?          @db.Uuid // bill-to (may differ from the served customer) — card #40.5
  reference      String
  status         String           @default("Unpaid") // Unpaid | Paid | Void | WrittenOff
  issueDate      DateTime         @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  paidBy         String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  payer          Contact?         @relation("InvoicePayer", fields: [payerContactId], references: [id])
  portions       InvoicePortion[]
  payments       Payment[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_invoice")
}

/// A portion of an invoice billed to one payer (card #40.5). Portions reconcile to the invoice total.
model InvoicePortion {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  invoiceId      String    @db.Uuid
  payerContactId String?   @db.Uuid
  payerName      String? // external payer (e.g. insurer not in Contacts)
  description    String
  amountCents    Int
  createdAt      DateTime  @default(now())
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  payer          Contact?  @relation("PortionPayer", fields: [payerContactId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("onestack_invoice_portion")
}

/// Money received against an invoice (optionally a specific portion) — card #40.5, per money-rules #29.
model Payment {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  invoiceId   String          @db.Uuid
  portionId   String?         @db.Uuid
  amountCents Int
  method      String // cash | bank_transfer | card | eftpos | other
  receivedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  invoice     Invoice         @relation(fields: [invoiceId], references: [id])
  portion     InvoicePortion? @relation(fields: [portionId], references: [id])

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("onestack_payment")
}

/// Generic per-tenant reference sequence (scope = 'quote' | 'invoice' | …). Card #30.
model ReferenceCounter {
  tenantId String @db.Uuid
  scope    String
  value    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, scope])
  @@map("onestack_reference_counter")
}

/// A quote on a job (card #30). Line items are the shared onestack_line_item; totals are derived.
model Quote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  workItemId   String   @db.Uuid // the job
  reference    String
  status       String   @default("Draft") // Draft | Sent | Accepted | Declined
  revision     Int      @default(1) // v1, v2… (card #33)
  supersedesId String?  @db.Uuid // the quote this one revises (history chain)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  supersedes   Quote?   @relation("QuoteRevision", fields: [supersedesId], references: [id])
  revisions    Quote[]  @relation("QuoteRevision")

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@index([tenantId, supersedesId])
  @@map("onestack_quote")
}

/// Metadata for a generated document (card #6.7). File bytes live in Supabase Storage; this row links
/// the stored file to its source entity and records the template version that produced it. Tenant-scoped.
model Document {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  type            String
  parentType      String
  parentId        String   @db.Uuid
  templateRef     String
  templateVersion String
  storageRef      String
  generatedAt     DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  signatures      DocumentSignature[]

  @@index([tenantId])
  @@index([tenantId, parentType, parentId])
  @@map("onestack_document")
}

/// An e-signature request on a generated document (card #143). An unguessable token opens a public sign
/// page (secure document exchange); the signer views the document and signs by typed-name acknowledgement.
/// A legally-binding CERTIFIED e-signature via a provider (DocuSign / Adobe Sign) is a deferred vendor,
/// recorded via `provider` + `certified` (the built-in flow is a basic, non-certified acknowledgement).
/// Tenant-scoped.
model DocumentSignature {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  documentId        String    @db.Uuid
  token             String    @unique
  signerName        String
  signerEmail       String?
  status            String    @default("pending") // 'pending' | 'signed' | 'declined'
  signedName        String?
  signedAt          DateTime?
  provider          String    @default("noop")
  certified         Boolean   @default(false)
  requestedByUserId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, documentId])
  @@map("onestack_document_signature")
}

/// Line Item shared by Quote & Invoice (card #6.9). Linked polymorphically by parentType + parentId.
/// Money is integer cents; net/gst/total are computed per docs/money-rules.md (#29) and stored.
model LineItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  parentType     String // 'quote' | 'invoice'
  parentId       String   @db.Uuid
  description    String
  type           String // labour | product | time
  quantity       Int
  unitPriceCents Int
  taxCode        String // GST | GST_FREE
  taxTreatment   String // inclusive | exclusive
  netCents       Int
  gstCents       Int
  lineTotalCents Int
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, parentType, parentId, sortOrder])
  @@map("onestack_line_item")
}

/// Immutable who-did-what trail (card #9.2). App role has INSERT+SELECT only (no UPDATE/DELETE).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("onestack_audit_log")
}

/// Internal + customer notifications across channels (card #9.1). Tenant-scoped.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  channel   String
  recipient String
  template  String
  payload   Json      @default("{}")
  status    String    @default("pending")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("onestack_notification")
}

/// Transactional outbox (cards #9 / #9.15). Events written in the same txn as the state change; a relay
/// publishes them. status pending → published, or → dead (DLQ) after max attempts.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  type          String
  payload       Json      @default("{}")
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@map("onestack_outbox_event")
}

/// Idempotency inbox (card #9.15): one row per (consumer, event); a duplicate delivery no-ops.
model InboxConsumed {
  tenantId     String   @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  consumedAt   DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@id([consumerName, eventId])
  @@index([tenantId])
  @@map("onestack_inbox_consumed")
}

/// Per-tenant module on/off flag (composition engine, cards #6 / #6.2). Tenant-scoped.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String // a ModuleKey (see src/composition/module-registry.ts)
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("onestack_feature_flag")
}

/// Links a Supabase auth user to a Tenant with a role. Tenant-scoped (carries tenantId → RLS).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid // Supabase auth user id (auth.users.id)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("onestack_membership")
}

/// The party served (customer / patient / client). Core primitive; walking-skeleton target. Tenant-scoped.
model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  displayName String
  email       String?
  phone       String?
  fields      Json      @default("{}")
  customFields Json     @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  subjects    Subject[]
  payerInvoices   Invoice[]        @relation("InvoicePayer")
  payerPortions   InvoicePortion[] @relation("PortionPayer")
  convertedLeads  Lead[]
  contactTags     ContactTag[]
  intakeSubmissions IntakeSubmission[]
  portalAccess    PortalAccess[]

  @@index([tenantId])
  @@map("onestack_contact")
}

/// Customer / client portal access (card #150). A per-customer, passwordless credential: an unguessable
/// token opens a branded self-service page (jobs, documents, quotes, invoices). Passwordless by design —
/// we do NOT hand-roll customer auth; the token is the credential and can be revoked. Tenant-scoped.
model PortalAccess {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  contactId       String    @db.Uuid
  token           String    @unique
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@map("onestack_portal_access")
}

/// A per-tenant brand profile (card #151) — business name, logo, colour, contact details — that
/// customer-facing surfaces (the public booking page, portal, …) render under. Generic core (white-label).
/// One row per tenant. Tenant-scoped.
model Brand {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @db.Uuid
  businessName String
  tagline      String?
  logoUrl      String?
  primaryColor String?
  contactPhone String?
  contactEmail String?
  websiteUrl   String?
  addressText  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("onestack_brand")
}

/// Digital intake & forms (Phase 3). A custom form a shop defines — a list of question fields — filled in
/// against a customer. Generic (Customer & CRM core). Tenant-scoped.
model IntakeForm {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  name        String
  fields      Json               @default("[]")
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  submissions IntakeSubmission[]

  @@index([tenantId])
  @@map("onestack_intake_form")
}

/// A completed intake form against a customer (Phase 3) — the answers land on the customer record.
model IntakeSubmission {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  intakeFormId      String     @db.Uuid
  contactId         String     @db.Uuid
  answers           Json       @default("{}")
  submittedByUserId String?    @db.Uuid
  submittedAt       DateTime   @default(now())
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  intakeForm        IntakeForm @relation(fields: [intakeFormId], references: [id], onDelete: Cascade)
  contact           Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@map("onestack_intake_submission")
}

/// Online booking (Phase 3). A per-tenant public self-service booking page: which resources are bookable,
/// the default slot length, and an unguessable token. Generic (Scheduling & Ops core). One per tenant.
/// Deposits (payments) + Google/social channels are deferred (not modelled here). Tenant-scoped.
model BookingPage {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @unique @db.Uuid
  publicToken String   @unique
  name        String   @default("Book online")
  enabled     Boolean  @default(false)
  slotMinutes Int      @default(60)
  resourceIds Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("onestack_booking_page")
}

/// Dispatch & assignment (Phase 3). The field/dispatch state of a job — a status + a manual ETA — so a
/// dispatcher can route work to a technician and see progress. Generic (Scheduling & Ops core). One per
/// job. GPS location + customer notifications are deferred (vendor). Tenant-scoped.
model Dispatch {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  workItemId      String    @unique @db.Uuid
  status          String    @default("pending") // pending | dispatched | en_route | on_site | completed
  etaAt           DateTime?
  note            String?
  updatedByUserId String?   @db.Uuid
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  workItem        WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("onestack_dispatch")
}

/// Segmentation & tagging (Phase 3). A named label a shop defines and assigns to contacts, so customers
/// can be grouped for targeted comms and reporting. Generic (Customer & CRM core). Tenant-scoped.
model Tag {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  name        String
  color       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  contactTags ContactTag[]
  campaigns   Campaign[]

  @@index([tenantId])
  @@map("onestack_tag")
}

/// Marketing campaigns (Phase 3). A one-shot segmented email/SMS message targeting a tag/segment. Generic
/// (Comms & Marketing core). Delivery is a vendor step behind a provider interface (no-op default).
/// Drip sequences + win-back are a follow-up. Tenant-scoped.
model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  name           String
  channel        String // 'email' | 'sms'
  subject        String?
  body           String    @default("")
  tagId          String?   @db.Uuid
  status         String    @default("draft") // 'draft' | 'sent'
  recipientCount Int?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  tag            Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("onestack_campaign")
}

/// Reviews & reputation (Phase 3). A review requested from a customer after a job (a tokenised link they
/// submit a star rating + comment through), aggregated into a reputation summary. Generic (Comms core).
/// Emailing the invite + pulling external reviews are deferred (vendor). Tenant-scoped.
model Review {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  workItemId        String?   @db.Uuid
  contactId         String?   @db.Uuid
  token             String    @unique
  status            String    @default("requested") // 'requested' | 'submitted'
  source            String    @default("web")
  reviewerName      String?
  rating            Int?
  comment           String?
  published         Boolean   @default(true)
  requestedByUserId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  submittedAt       DateTime?
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("onestack_review")
}

/// AI assistant / receptionist (Phase 3). A provider-abstracted AI that DRAFTS a reply to a customer
/// question for staff to review before sending. Generic (Workflow & AI core). Every answer is an editable
/// draft — nothing auto-sent. Each ask + drafted answer is logged. Tenant-scoped.
model AssistantMessage {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  workItemId      String?   @db.Uuid
  contactId       String?   @db.Uuid
  question        String
  answer          String
  model           String
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("onestack_assistant_message")
}

/// A tag assigned to a contact (Phase 3). The many-to-many join; a tag groups many contacts (a segment).
model ContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tagId     String   @db.Uuid
  contactId String   @db.Uuid
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tagId, contactId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, tagId])
  @@map("onestack_contact_tag")
}

/// The generic central unit of work (card #6.3). NO vertical nouns — type/state/fields are pack config.
model WorkItem {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  type            String
  stateName       String
  workflowVersion Int
  reference       String
  assignees       Json              @default("[]")
  fields          Json              @default("{}")
  bookingIds      Json              @default("[]")
  version         Int               @default(1) // optimistic lock
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  subjects        WorkItemSubject[]
  notes           WorkItemNote[]
  attachments     WorkItemAttachment[]
  bookings        Booking[]
  damageScopes    DamageScope[]
  scopeParts      ScopePart[]
  purchaseOrders  PurchaseOrder[]
  materialRequests MaterialRequest[]
  supplierInvoices SupplierInvoice[]
  dispatch        Dispatch?

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@map("onestack_work_item")
}

/// A running note on a work item (card #21) — text + who + when. Newest-first log. Tenant-scoped.
model WorkItemNote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  workItemId   String   @db.Uuid
  authorUserId String   @db.Uuid
  body         String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  workItem     WorkItem @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_work_item_note")
}

/// A file attached to a work item (card #21) — photos of the car/damage/work. Bytes live in Supabase
/// Storage under a per-tenant path; this row holds the metadata. Tenant-scoped.
model WorkItemAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  workItemId       String   @db.Uuid
  storageRef       String
  fileName         String
  contentType      String
  sizeBytes        Int
  caption          String?
  uploadedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  workItem         WorkItem @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_work_item_attachment")
}

/// A bookable thing — a bay, a technician, a room (card #23). Set up per shop. Part of the toggleable
/// `scheduling` module. Tenant-scoped.
model Resource {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  type      String // 'bay' | 'technician'
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  bookings  Booking[]

  @@index([tenantId])
  @@map("onestack_resource")
}

/// A reservation of one resource for a time range (card #23), optionally linked to a work item.
/// Overlaps on the same resource are prevented unless explicitly overridden. Tenant-scoped.
model Booking {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  resourceId String    @db.Uuid
  workItemId String?   @db.Uuid
  title      String
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  resource   Resource  @relation(fields: [resourceId], references: [id])
  workItem   WorkItem? @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, resourceId, startsAt])
  @@index([tenantId, workItemId])
  @@map("onestack_booking")
}

/// A shop's public web form (card #12), addressed by an unguessable token embedded in the snippet /
/// hosted page. Submissions create Leads under this form's tenant. Tenant-scoped.
model LeadForm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  publicToken String   @unique
  name        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  leads       Lead[]

  @@index([tenantId])
  @@map("onestack_lead_form")
}

/// An inbound enquiry (card #12). Converts into a Contact (the shared core record) + optionally a job.
/// New → Contacted → Converted. Tenant-scoped.
model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  formId             String?   @db.Uuid
  name               String
  phone              String
  email              String?
  message            String?
  vehicleInfo        String?
  source             String    @default("web_form")
  status             String    @default("New")
  convertedContactId String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  form               LeadForm? @relation(fields: [formId], references: [id])
  convertedContact   Contact?  @relation(fields: [convertedContactId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("onestack_lead")
}

/// A per-tenant custom field definition (card #11) for customers or vehicles. Values live in the target
/// record's `customFields` JSONB. Archiving hides the field but preserves existing values. Tenant-scoped.
model CustomField {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  appliesTo String // 'customer' | 'vehicle'
  key       String
  label     String
  type      String // 'text' | 'number' | 'date' | 'select' | 'boolean'
  required  Boolean  @default(false)
  options   Json     @default("[]")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, appliesTo, key])
  @@index([tenantId])
  @@map("onestack_custom_field")
}

/// The shop's reusable catalogue of labour items & parts with default prices (card #32). Picking an item
/// COPIES its values onto a quote/invoice line — the line is then independently editable and never
/// mutates the book. Prices are integer cents. Deactivating hides it from search; existing lines keep
/// their copied values. Tenant-scoped.
model PriceBookItem {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  name                  String
  description           String?
  type                  String // 'labour' | 'part'
  unit                  String // 'hour' | 'each'
  defaultUnitPriceCents Int
  code                  String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("onestack_price_book_item")
}

/// AI photo-to-quote (Phase 2 flagship, slice A). The AI's proposed damage scope for a job, held as an
/// EDITABLE DRAFT a human confirms — nothing auto-sent or auto-ordered. `items` is a list of panels +
/// operations (replace | repair | paint); "replace" items become priced part lines downstream. Generic
/// storage — the automotive meaning lives in the pack. `model` records which analyzer produced it. Tenant-scoped.
model DamageScope {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  workItemId String   @db.Uuid
  status     String   @default("draft") // 'draft' | 'applied'
  source     String   @default("ai") // 'ai' | 'manual'
  model      String
  summary    String   @default("")
  items      Json     @default("[]")
  photoCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  workItem   WorkItem @relation(fields: [workItemId], references: [id])
  parts      ScopePart[]

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_damage_scope")
}

/// AI photo-to-quote (Phase 2 flagship, slice B). The editable parts list derived from a damage scope's
/// "replace" panels, priced from the price book or left at 0 for the estimator. A DRAFT working list —
/// a fully-priced one is turned into a real quote through the shared Quote engine. Nothing is ordered.
/// Generic (Sales & Money core). Tenant-scoped.
model ScopePart {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  workItemId      String       @db.Uuid
  damageScopeId   String?      @db.Uuid
  description     String
  quantity        Int          @default(1)
  unitPriceCents  Int          @default(0)
  priceBookItemId String?      @db.Uuid
  source          String       @default("ai") // 'ai' | 'manual'
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  workItem        WorkItem     @relation(fields: [workItemId], references: [id])
  damageScope     DamageScope? @relation(fields: [damageScopeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_scope_part")
}

/// AI photo-to-quote (Phase 2 flagship, slice C). A draft purchase order — the parts to buy from a
/// supplier for a job — that a human confirms. NOTHING is sent: emailing the supplier is a separate,
/// vendor-gated step. Its own line table (a PO is what we expect to pay a supplier, not a customer
/// money document). Generic (Sales & Money core). Tenant-scoped.
model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  workItemId        String              @db.Uuid
  supplierContactId String?             @db.Uuid
  reference         String
  status            String              @default("draft") // 'draft' | 'confirmed' | 'sent'
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  workItem          WorkItem            @relation(fields: [workItemId], references: [id])
  lines             PurchaseOrderLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_purchase_order")
}

/// A line on a draft purchase order (Phase 2 flagship, slice C). Expected cost to us, editable draft.
model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  scopePartId     String?       @db.Uuid
  description     String
  quantity        Int           @default(1)
  unitPriceCents  Int           @default(0)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@map("onestack_purchase_order_line")
}

/// Floor ordering (Phase 2). A shop-floor material request: a technician asks for the materials a job
/// needs; a manager (OWNER) approves or rejects; an approved request can be ordered (emailed to a
/// supplier — a vendor-gated step, no-op until wired). Just a list of items by description + quantity;
/// pricing is the PO's job. Generic (Sales & Money core). Tenant-scoped.
model MaterialRequest {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  workItemId        String                @db.Uuid
  reference         String
  status            String                @default("requested") // 'requested' | 'approved' | 'rejected' | 'ordered'
  requestedByUserId String                @db.Uuid
  decidedByUserId   String?               @db.Uuid
  decisionNote      String?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  workItem          WorkItem              @relation(fields: [workItemId], references: [id])
  lines             MaterialRequestLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_material_request")
}

/// A line on a material request (Phase 2 — floor ordering). An item the technician wants, by qty.
model MaterialRequestLine {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  materialRequestId String          @db.Uuid
  description       String
  quantity          Int             @default(1)
  notes             String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, materialRequestId])
  @@map("onestack_material_request_line")
}

/// Supplier invoice capture (Phase 2). A supplier's invoice captured against a job as an editable draft
/// a human confirms. OCR (pre-fill from a scan) and accounting sync (Xero/MYOB) are deferred, stubbed
/// behind provider interfaces. Its own line table — a supplier invoice is what we OWE, not a customer
/// money document, so it never touches the customer money engine. Generic (Sales & Money core). Tenant-scoped.
model SupplierInvoice {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  workItemId        String                @db.Uuid
  supplierContactId String?               @db.Uuid
  invoiceNumber     String
  invoiceDate       String?
  status            String                @default("draft") // 'draft' | 'confirmed' | 'exported'
  source            String                @default("manual") // 'manual' | 'ocr'
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  workItem          WorkItem              @relation(fields: [workItemId], references: [id])
  lines             SupplierInvoiceLine[]

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_supplier_invoice")
}

/// A line on a captured supplier invoice (Phase 2). What we owe per item; editable draft.
model SupplierInvoiceLine {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  supplierInvoiceId String          @db.Uuid
  description       String
  quantity          Int             @default(1)
  unitPriceCents    Int             @default(0)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, supplierInvoiceId])
  @@map("onestack_supplier_invoice_line")
}

/// Per-tenant reference sequence for Work Items (card #6.3).
model WorkItemCounter {
  tenantId String @id @db.Uuid
  value    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("onestack_work_item_counter")
}

/// Optional, pack-typed "thing the work is about" (card #6.4) — vehicle, property, case file.
model Subject {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  type      String
  label     String
  fields    Json              @default("{}")
  customFields Json           @default("{}")
  contactId String?           @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  contact   Contact?          @relation(fields: [contactId], references: [id])
  workItems WorkItemSubject[]

  @@index([tenantId])
  @@map("onestack_subject")
}

/// Work Item <-> Subject link (0-many both ways).
model WorkItemSubject {
  tenantId   String   @db.Uuid
  workItemId String   @db.Uuid
  subjectId  String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  workItem   WorkItem @relation(fields: [workItemId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])

  @@id([workItemId, subjectId])
  @@index([tenantId])
  @@map("onestack_work_item_subject")
}

/// A customer waiting for a slot (card #210). A cancellation can be filled from here to protect
/// utilisation; the owner confirms the fill into a booking. Generic core (Scheduling & Ops). Tenant-scoped.
model WaitlistEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  contactId  String?  @db.Uuid
  name       String
  phone      String
  resourceId String?  @db.Uuid
  notes      String?
  status     String   @default("waiting") // 'waiting' | 'booked' | 'removed'
  bookingId  String?  @db.Uuid
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("onestack_waitlist_entry")
}

/// A staff shift / time-off block (card #211). Generic core (Scheduling & Ops). staffUserId optionally
/// links a platform user; staffName is the displayed label. Tenant-scoped.
model Shift {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  staffUserId String?  @db.Uuid
  staffName   String
  kind        String   @default("shift") // 'shift' | 'time_off'
  startsAt    DateTime
  endsAt      DateTime
  notes       String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startsAt])
  @@map("onestack_shift")
}

/// An inventory item with on-hand stock (card #220). Generic core (Sales & Money). Tenant-scoped.
model InventoryItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String
  sku            String?
  unit           String?
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  unitCostCents  Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  movements      StockMovement[]

  @@index([tenantId])
  @@map("onestack_inventory_item")
}

/// An append-only stock change (receive / use / adjust) that also updates the item's on-hand qty (card #220).
model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  itemId          String   @db.Uuid
  delta           Int
  reason          String   @default("adjust") // 'receive' | 'use' | 'adjust'
  note            String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, itemId])
  @@map("onestack_stock_movement")
}
