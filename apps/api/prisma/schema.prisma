// OneStack core data model — industry-neutral (no vertical nouns).
// Vehicle/Job etc. live in the automotive PACK, never here. See docs/architecture.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // owner/direct (Supabase `postgres`) — migrations + provisioning
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  STAFF

  @@map("onestack_role")
}

/// A customer of OneStack (one shop / clinic / firm). Owns everything. Not tenant-scoped (it IS the scope).
model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships      Membership[]
  contacts         Contact[]
  featureFlags     FeatureFlag[]
  workItems        WorkItem[]
  workItemCounter  WorkItemCounter?
  subjects         Subject[]
  workItemSubjects WorkItemSubject[]
  outboxEvents     OutboxEvent[]
  inboxConsumed    InboxConsumed[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  lineItems         LineItem[]
  documents         Document[]
  quotes            Quote[]
  referenceCounters ReferenceCounter[]
  invoices          Invoice[]
  invoicePortions   InvoicePortion[]
  payments          Payment[]
  workItemNotes       WorkItemNote[]
  workItemAttachments WorkItemAttachment[]
  resources           Resource[]
  bookings            Booking[]
  leadForms           LeadForm[]
  leads               Lead[]

  @@map("onestack_tenant")
}

/// An invoice on a job (card #40), optionally from an accepted quote. Line items are the shared
/// onestack_line_item; totals derived. Paid manually (records who + when). Tenant-scoped.
model Invoice {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  workItemId     String           @db.Uuid // the job
  quoteId        String?          @db.Uuid // source quote (optional)
  payerContactId String?          @db.Uuid // bill-to (may differ from the served customer) — card #40.5
  reference      String
  status         String           @default("Unpaid") // Unpaid | Paid | Void | WrittenOff
  issueDate      DateTime         @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  paidBy         String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  payer          Contact?         @relation("InvoicePayer", fields: [payerContactId], references: [id])
  portions       InvoicePortion[]
  payments       Payment[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_invoice")
}

/// A portion of an invoice billed to one payer (card #40.5). Portions reconcile to the invoice total.
model InvoicePortion {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  invoiceId      String    @db.Uuid
  payerContactId String?   @db.Uuid
  payerName      String? // external payer (e.g. insurer not in Contacts)
  description    String
  amountCents    Int
  createdAt      DateTime  @default(now())
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  payer          Contact?  @relation("PortionPayer", fields: [payerContactId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("onestack_invoice_portion")
}

/// Money received against an invoice (optionally a specific portion) — card #40.5, per money-rules #29.
model Payment {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  invoiceId   String          @db.Uuid
  portionId   String?         @db.Uuid
  amountCents Int
  method      String // cash | bank_transfer | card | eftpos | other
  receivedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  invoice     Invoice         @relation(fields: [invoiceId], references: [id])
  portion     InvoicePortion? @relation(fields: [portionId], references: [id])

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@map("onestack_payment")
}

/// Generic per-tenant reference sequence (scope = 'quote' | 'invoice' | …). Card #30.
model ReferenceCounter {
  tenantId String @db.Uuid
  scope    String
  value    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, scope])
  @@map("onestack_reference_counter")
}

/// A quote on a job (card #30). Line items are the shared onestack_line_item; totals are derived.
model Quote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  workItemId String   @db.Uuid // the job
  reference  String
  status     String   @default("Draft") // Draft | Sent | Accepted | Declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_quote")
}

/// Metadata for a generated document (card #6.7). File bytes live in Supabase Storage; this row links
/// the stored file to its source entity and records the template version that produced it. Tenant-scoped.
model Document {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  type            String
  parentType      String
  parentId        String   @db.Uuid
  templateRef     String
  templateVersion String
  storageRef      String
  generatedAt     DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, parentType, parentId])
  @@map("onestack_document")
}

/// Line Item shared by Quote & Invoice (card #6.9). Linked polymorphically by parentType + parentId.
/// Money is integer cents; net/gst/total are computed per docs/money-rules.md (#29) and stored.
model LineItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  parentType     String // 'quote' | 'invoice'
  parentId       String   @db.Uuid
  description    String
  type           String // labour | product | time
  quantity       Int
  unitPriceCents Int
  taxCode        String // GST | GST_FREE
  taxTreatment   String // inclusive | exclusive
  netCents       Int
  gstCents       Int
  lineTotalCents Int
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, parentType, parentId, sortOrder])
  @@map("onestack_line_item")
}

/// Immutable who-did-what trail (card #9.2). App role has INSERT+SELECT only (no UPDATE/DELETE).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("onestack_audit_log")
}

/// Internal + customer notifications across channels (card #9.1). Tenant-scoped.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  channel   String
  recipient String
  template  String
  payload   Json      @default("{}")
  status    String    @default("pending")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("onestack_notification")
}

/// Transactional outbox (cards #9 / #9.15). Events written in the same txn as the state change; a relay
/// publishes them. status pending → published, or → dead (DLQ) after max attempts.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  type          String
  payload       Json      @default("{}")
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@map("onestack_outbox_event")
}

/// Idempotency inbox (card #9.15): one row per (consumer, event); a duplicate delivery no-ops.
model InboxConsumed {
  tenantId     String   @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  consumedAt   DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@id([consumerName, eventId])
  @@index([tenantId])
  @@map("onestack_inbox_consumed")
}

/// Per-tenant module on/off flag (composition engine, cards #6 / #6.2). Tenant-scoped.
model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String // a ModuleKey (see src/composition/module-registry.ts)
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("onestack_feature_flag")
}

/// Links a Supabase auth user to a Tenant with a role. Tenant-scoped (carries tenantId → RLS).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid // Supabase auth user id (auth.users.id)
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("onestack_membership")
}

/// The party served (customer / patient / client). Core primitive; walking-skeleton target. Tenant-scoped.
model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  displayName String
  email       String?
  phone       String?
  fields      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  subjects    Subject[]
  payerInvoices   Invoice[]        @relation("InvoicePayer")
  payerPortions   InvoicePortion[] @relation("PortionPayer")
  convertedLeads  Lead[]

  @@index([tenantId])
  @@map("onestack_contact")
}

/// The generic central unit of work (card #6.3). NO vertical nouns — type/state/fields are pack config.
model WorkItem {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  type            String
  stateName       String
  workflowVersion Int
  reference       String
  assignees       Json              @default("[]")
  fields          Json              @default("{}")
  bookingIds      Json              @default("[]")
  version         Int               @default(1) // optimistic lock
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  subjects        WorkItemSubject[]
  notes           WorkItemNote[]
  attachments     WorkItemAttachment[]
  bookings        Booking[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@map("onestack_work_item")
}

/// A running note on a work item (card #21) — text + who + when. Newest-first log. Tenant-scoped.
model WorkItemNote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  workItemId   String   @db.Uuid
  authorUserId String   @db.Uuid
  body         String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  workItem     WorkItem @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_work_item_note")
}

/// A file attached to a work item (card #21) — photos of the car/damage/work. Bytes live in Supabase
/// Storage under a per-tenant path; this row holds the metadata. Tenant-scoped.
model WorkItemAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  workItemId       String   @db.Uuid
  storageRef       String
  fileName         String
  contentType      String
  sizeBytes        Int
  caption          String?
  uploadedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  workItem         WorkItem @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, workItemId])
  @@map("onestack_work_item_attachment")
}

/// A bookable thing — a bay, a technician, a room (card #23). Set up per shop. Part of the toggleable
/// `scheduling` module. Tenant-scoped.
model Resource {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  type      String // 'bay' | 'technician'
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  bookings  Booking[]

  @@index([tenantId])
  @@map("onestack_resource")
}

/// A reservation of one resource for a time range (card #23), optionally linked to a work item.
/// Overlaps on the same resource are prevented unless explicitly overridden. Tenant-scoped.
model Booking {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  resourceId String    @db.Uuid
  workItemId String?   @db.Uuid
  title      String
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  resource   Resource  @relation(fields: [resourceId], references: [id])
  workItem   WorkItem? @relation(fields: [workItemId], references: [id])

  @@index([tenantId])
  @@index([tenantId, resourceId, startsAt])
  @@index([tenantId, workItemId])
  @@map("onestack_booking")
}

/// A shop's public web form (card #12), addressed by an unguessable token embedded in the snippet /
/// hosted page. Submissions create Leads under this form's tenant. Tenant-scoped.
model LeadForm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  publicToken String   @unique
  name        String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  leads       Lead[]

  @@index([tenantId])
  @@map("onestack_lead_form")
}

/// An inbound enquiry (card #12). Converts into a Contact (the shared core record) + optionally a job.
/// New → Contacted → Converted. Tenant-scoped.
model Lead {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  formId             String?   @db.Uuid
  name               String
  phone              String
  email              String?
  message            String?
  vehicleInfo        String?
  source             String    @default("web_form")
  status             String    @default("New")
  convertedContactId String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  form               LeadForm? @relation(fields: [formId], references: [id])
  convertedContact   Contact?  @relation(fields: [convertedContactId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("onestack_lead")
}

/// Per-tenant reference sequence for Work Items (card #6.3).
model WorkItemCounter {
  tenantId String @id @db.Uuid
  value    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("onestack_work_item_counter")
}

/// Optional, pack-typed "thing the work is about" (card #6.4) — vehicle, property, case file.
model Subject {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  type      String
  label     String
  fields    Json              @default("{}")
  contactId String?           @db.Uuid
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  contact   Contact?          @relation(fields: [contactId], references: [id])
  workItems WorkItemSubject[]

  @@index([tenantId])
  @@map("onestack_subject")
}

/// Work Item <-> Subject link (0-many both ways).
model WorkItemSubject {
  tenantId   String   @db.Uuid
  workItemId String   @db.Uuid
  subjectId  String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  workItem   WorkItem @relation(fields: [workItemId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])

  @@id([workItemId, subjectId])
  @@index([tenantId])
  @@map("onestack_work_item_subject")
}
