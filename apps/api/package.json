{
  "name": "@onestack/api",
  "version": "0.0.0",
  "private": true,
  "description": "OneStack API + background workers (NestJS). Hosts on Fly.io (Sydney); data on Supabase (Sydney).",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:setup": "echo 'Run scripts/supabase-setup.sql once in the Supabase SQL editor (creates app_user + token hook).'",
    "check:rls": "tsx scripts/check-rls.ts",
    "check:migrations": "tsx scripts/check-destructive-migrations.ts",
    "audit:ci": "audit-ci --config .audit-ci.jsonc",
    "migrate:roundtrip": "tsx scripts/migrate-roundtrip.ts",
    "test": "vitest run src/",
    "test:int": "vitest run test/",
    "test:cov": "vitest run src/ --coverage",
    "coverage:ratchet": "tsx scripts/coverage-ratchet.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "@xstate/fsm": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@playwright/test": "^1.47.2",
    "@swc/core": "^1.7.26",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "audit-ci": "^7.1.0",
    "dotenv": "^16.4.5",
    "fast-check": "^3.22.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.0.5"
  }
}
