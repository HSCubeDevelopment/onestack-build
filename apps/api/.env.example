# apps/api/.env — copy to `.env` and fill from Supabase (Sydney project). NEVER commit .env.

# Owner/direct connection (Supabase `postgres`) — migrations, provisioning, RLS CI check.
# Use the Supabase "Direct connection" string (port 5432).
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Least-privilege runtime role (created by scripts/supabase-setup.sql). ALL request queries use this.
# Prefer the Supabase pooler (port 6543) so the leak test exercises pooled connections.
APP_DATABASE_URL="postgresql://app_user:APP_PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=3"

# Supabase Auth JWT secret (Supabase → Project Settings → API → JWT Secret). Verifies access tokens.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

PORT=3001

# Supabase Storage (card #6.7 document service) — service-role key + a private bucket.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Public anon key (Supabase → Project Settings → API). Used for the /auth/login password grant.
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_DOCUMENTS_BUCKET="onestack_documents"

# --- AI: photo-to-scope damage estimation + assistant (Phase 2 flagship) ---
# When ANTHROPIC_API_KEY is set, the real Anthropic Claude vision adapter turns a job's uploaded photos
# into an editable draft damage scope (and powers the assistant). Unset ⇒ a deterministic stub runs, so
# the whole flow still works locally/CI with no external API. Store it as a SECRET (never commit a value):
# locally in this .env; in prod as a Cloud Run secret, not a plaintext env var.
ANTHROPIC_API_KEY=""
# Optional model override for the damage-scope adapter (defaults to claude-opus-4-8).
# AI_SCOPE_MODEL="claude-opus-4-8"

# --- Time-clock / real-login demo (LOCAL + STAGING ONLY — never set DEV_LOGIN_ENABLED=true in prod) ---
# The seeded demo tenant + sample Supabase Auth logins created by `npm run seed:auth`. The sign-in page's
# demo-credentials endpoint only serves these when DEV_LOGIN_ENABLED=true AND NODE_ENV!=='production'.
NODE_ENV=development
DEV_LOGIN_ENABLED=true
DEMO_TENANT_ID="0d15ea5e-0000-4000-8000-000000000001"
DEMO_OWNER_EMAIL="owner@onestack.test"
DEMO_OWNER_PASSWORD="Owner!2345"
DEMO_STAFF_EMAIL="staff@onestack.test"
DEMO_STAFF_PASSWORD="Staff!2345"
# Tow driver demo login (seeded as a STAFF member; shown as "Tow" on the sign-in page).
DEMO_TOW_EMAIL="tow@onestack.test"
DEMO_TOW_PASSWORD="Tow!2345"

# --- Check-in geofence (card 53.1) ---
# Where staff must be standing to clock on. The defaults in code are GEOCODED from the street address
# of 15 Lipton Drive, Thomastown VIC — a lookup, not a measurement. Correct them here BEFORE go-live:
# stand in the workshop doorway, read the coordinates off a phone, paste them in, restart the API.
# No deploy and no developer required. The API prints the active fence on every boot.
#
# Both coordinates must be set together (setting one alone is rejected — it would move the fence to a
# paddock). Radius must be 20–5000 m: under 20 m is tighter than GPS error and refuses people standing
# at their own bench; over 5000 m is not a workshop. Bad values are ignored WITH A WARNING, not applied.
# WORKSHOP_LATITUDE=-37.6829
# WORKSHOP_LONGITUDE=145.0169
# WORKSHOP_RADIUS_METRES=150
# WORKSHOP_LABEL="15 Lipton Drive, Thomastown VIC"
