# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment / secrets — NEVER commit real secrets
.env
.env.*
!.env.example

# Test / coverage (ignore reports, but TRACK the ratchet baseline)
coverage/*
!coverage/baseline.json
apps/*/coverage/*
!apps/*/coverage/baseline.json
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*

# Claude Code local (personal permissions/settings — not shared)
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Fly / Vercel local
.vercel
.fly

# In N Out → OneStack refresh working data. The CSV/JSONL exports carry customer PII (driver and owner
# names, phone numbers, free-text notes) and the photo-download ledger. NEVER commit.
apps/api/scripts/.innout-work/

# Safety net: the exporter writes these bare names, so a run with the wrong cwd would otherwise drop
# PII wherever it was invoked.
veh.csv
mov.csv
ret.csv
bok.csv
photos.jsonl
photos_done.jsonl
photos_load.csv
