# OneStack — environment template. Copy to `.env` per app and fill from the secret manager.
# NEVER commit a real .env. All services are AU-region.

# --- Supabase (Sydney) — Postgres + Auth + Storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# App connects as a NON-superuser, NON-BYPASSRLS role (tenant isolation depends on this):
DATABASE_URL=postgresql://app_user:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://app_user:PASSWORD@HOST:5432/postgres

# --- API (Fly.io Sydney) ---
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# --- Web (Vercel syd1) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
