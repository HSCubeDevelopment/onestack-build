# Keep the Cloud Build source upload small. The image installs its own deps and builds fresh, so none
# of these are needed in the build context.
.git
**/node_modules
**/dist
**/.next
**/.turbo
**/.expo
coverage
playwright-report
**/*.log
onestack-mobile
# Secrets — this file previously had no .env rule at all, unlike .dockerignore, so a local .env would
# have been uploaded with the build source.
**/*.env
**/*.env.*
# Refresh working data — customer PII, and up to ~1.6 GB of it.
**/.innout-work/
